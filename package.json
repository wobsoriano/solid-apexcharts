{
  "name": "solid-apexcharts",
  "version": "0.6.0",
  "private": false,
  "description": "Solid component for ApexCharts",
  "keywords": [
    "charts",
    "solid"
  ],
  "homepage": "https://github.com/wobsoriano/solid-apexcharts#readme",
  "bugs": {
    "url": "https://github.com/wobsoriano/solid-apexcharts/issues"
  },
  "license": "MIT",
  "author": "Robert Soriano",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wobsoriano/solid-apexcharts.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "solid": "./dist/index.jsx",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "vp dev dev",
    "prepare": "vp config",
    "build": "vp pack",
    "test": "playwright test",
    "prepublishOnly": "pnpm build",
    "typecheck": "tsc --noEmit && tsc -p dev --noEmit",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "format": "vp fmt",
    "check": "vp check",
    "release": "bumpp && pnpm publish"
  },
  "dependencies": {
    "defu": "^6.1.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@solidjs/vite-plugin": "3.0.0-next.51",
    "@solidjs/web": "2.0.0-rc.18",
    "@types/node": "^24.13.3",
    "apexcharts": "^4.3.0",
    "bumpp": "^9.3.0",
    "solid-js": "2.0.0-rc.18",
    "typescript": "^6.0.3",
    "unplugin-solid": "^3.0.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vite-plus": "^1.4.0"
  },
  "peerDependencies": {
    "@solidjs/web": ">=2.0.0-rc.16 <3",
    "apexcharts": "^4.0.0 || ^5.0.0",
    "solid-js": ">=2.0.0-rc.16 <3"
  },
  "packageManager": "pnpm@10.14.0",
  "pnpm": {
    "overrides": {
      "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
      "vitest": "5.0.5"
    }
  }
}
